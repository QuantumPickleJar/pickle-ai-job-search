{
  "manifest_version": 3,
  "name": "LinkedIn Job Clipper",
  "version": "0.1.0",
  "description": "Capture the currently open LinkedIn job posting and save it to a configured ai-job-search service endpoint.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save LinkedIn job"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://linkedin.com/jobs/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
